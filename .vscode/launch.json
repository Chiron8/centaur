{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug centaur (sudo)",
      "type": "cppdbg",
      "request": "launch",

      "program": "/usr/bin/sudo",
      "args": [
        "--",
        "${workspaceFolder}/centaur",
        "install",
        "writedoc-2.3-p1"
      ],

      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "externalConsole": true,

      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb"
    }
  ]
}