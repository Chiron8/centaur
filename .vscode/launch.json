{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug centaur (sudo gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "/usr/bin/centaur",
            "args": ["install", "example"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/sudo",
            "miDebuggerArgs": "gdb",
            "preLaunchTask": "cmake-build"
        }
    ]
}