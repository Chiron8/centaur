[meta]
name = "ncurses"
version = "6.6"
dependencies = ""
source = "https://invisible-island.net/archives/ncurses/ncurses-6.6.tar.gz"
checksum = "355b4cbbed880b0381a04c46617b7656e362585d52e9cf84a67e2009b749ff11"
source_directory = "ncurses-6.6"
[/meta]

[install]
echo "configuring and compiling"
./configure --with-shared --without-debug --without-normal --with-cxx-shared --enable-pc-files
make

make DESTDIR=$PWD/dest install

echo "running configuration..."
install -vm755 dest/usr/lib/libncursesw.so.6.6 /usr/lib
sed -e 's/^#if.*XOPEN.*$/#if 1/' -i dest/usr/include/curses.h
cp -av dest/* /

for lib in ncurses form panel menu; do ln -sfv lib${lib}w.so /usr/lib/lib${lib}.so && ln -sfv ${lib}w.pc /usr/lib/pkgconfig/${lib}.pc; done

ln -sfv libncursesw.so /usr/lib/libcurses.so

cp -v -R doc -T /usr/share/doc/ncurses-6.6
[/install]
