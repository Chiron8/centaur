[install]
echo "Downloading..."
cd /tmp/centaur
wget https://github.com/Chiron8/writedoc/archive/refs/tags/v2.3-p1.tar.gz

echo "Installing..."
tar -xf v2.3-p1.tar.gz
cd /tmp/centaur/writedoc-2.3-p1/
./install.sh

echo "Finished installing! "
echo "Tidying Files..."
cd ../
rm v2.3-p1.tar.gz
rm -r writedoc-2.3-p1/

echo "Finished!"
[/install]
