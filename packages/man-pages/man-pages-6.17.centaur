[meta]
name = "man-pages"
version = "6.17"
dependencies = ""
sbu = "0.1"
source = "https://www.kernel.org/pub/linux/docs/man-pages/man-pages-6.17.tar.xz"
checksum = "d18f21a602b09778a5a9096bf1be8441b7733e998150474accf703d165f4ebf4"
source_directory = "man-pages-6.17"
[/meta]

[install]
echo "installing..."
rm -v man3/crypt*
make -R GIT=false prefix=/usr install
[/install]

[uninstall]
cd /tmp/centaur
wget https://www.kernel.org/pub/linux/docs/man-pages/man-pages-6.17.tar.xz
tar -xf man-pages-6.17.tar.xz
cd man-pages-6.17
make uninstall
cd ../
rm -r man-pages-6.17
rm man-pages-6.17.tar.xz
